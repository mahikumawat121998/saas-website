{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saas-website",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "saas-website"
    }
  ]
}
